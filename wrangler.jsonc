{
  // 部署到 Cloudflare 时更新的项目名，必须是「域名绑在上面」的那个项目。
  // 同名才会更新原项目；名字写错不会报错，而是悄悄新建一个项目，
  // 于是命令行显示成功、线上却一直没变——域名跟着哪个项目走，访问到的就是哪个项目的内容。
  "name": "drop-a1f675be-af2",

  // 兼容日期：决定运行时按哪一版规则行事，取一个较新的日期即可。
  // 本项目只用一个最基础的 fetch 处理器，不依赖任何新近才有的运行时特性。
  "compatibility_date": "2026-10-07",

  // 入口脚本：在静态资源前面拦一道，挡掉「直接输入 js、css 网址」的访问，
  // 具体判断方式写在 worker.js 顶部。它只负责拦截，不参与页面本身的逻辑。
  "main": "worker.js",

  // 要上传的目录：只上传 dist（发布成品），源码目录、文档、旧版本文件都不会被传上去。
  // 因此每次更新前，必须先把根目录的源码同步进 dist，否则传上去的还是旧内容。
  "assets": {
    "directory": "./dist",

    // 绑定名：Worker 里用 env.ASSETS.fetch 取静态资源，两处的名字必须一致
    "binding": "ASSETS",

    // 只有这些路径先经过 Worker 判断；其余请求仍按「静态资源优先」直接返回，不必绕路
    "run_worker_first": ["/js/*", "/css/*"]
  }
}
